# Copy to .env and fill in. Never commit .env.

# The password you type to log in to the dashboard.
APP_PASSWORD=

# Signs the login cookie. At least 32 characters. Generate with:
#   openssl rand -base64 48
SESSION_SECRET=

# The sign presents this when it connects. Generate with:
#   openssl rand -hex 32
DEVICE_TOKEN=

# Optional. Lets a Stream Deck or script send presets and flip switches.
# Leave empty to switch that off. Generate with:
#   openssl rand -hex 32
API_TOKEN=

# Optional. Scheduled messages use this timezone's clock.
# Defaults to America/Denver.
TIMEZONE=
