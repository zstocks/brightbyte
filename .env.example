# Copy to .env and fill in. Never commit .env.

# The password you type to log in to the dashboard.
APP_PASSWORD=

# Signs the login cookie. At least 32 characters. Generate with:
#   openssl rand -base64 48
SESSION_SECRET=

# The sign presents this when it connects (used from Phase 5). Generate with:
#   openssl rand -hex 32
DEVICE_TOKEN=
